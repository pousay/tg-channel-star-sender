# Telegram Bot Token (get from @BotFather)
BOT_TOKEN=your_bot_token_here

# Telegram API credentials (get from https://my.telegram.org)
API_ID=your_api_id_here
API_HASH=your_api_hash_here

# Comma-separated list of admin Telegram user IDs.
# These admins manage the bot panel AND receive all event logs.
ADMIN_IDS=123456789,987654321

# Path to the JSON database file
DB_PATH=data/accounts.json

# Directory to store user session files
SESSIONS_DIR=sessions

# ── Channel auto-reactions + Star gifting ──

# Channel to monitor (ID like -1001234567890 or @username); bot must be an admin there.
# For private channels use the full numeric ID (with the -100 prefix).
TARGET_CHANNEL=@mychannel

# ── Channel polling ──

# Minutes between poll cycles: each cycle fetches the latest posts and
# decides which ones must be processed
POLL_INTERVAL_MINUTES=5

# How many latest posts each poll cycle fetches
POLL_FETCH_COUNT=10

# A keyword post first seen older than this (minutes) is skipped as stale
POST_MAX_AGE_MINUTES=60

# JSON store of already-checked posts (dedupe across poll cycles)
POSTS_DB_PATH=data/processed_posts.json

# Keyword that must appear in a post's text or caption for it to be processed
POST_KEYWORD=giveaway

# Minutes to wait after detecting a qualifying post before acting
DELAY_MINUTES=13

# Random number of accounts to use per post is drawn between MIN and MAX
MIN_ACCOUNTS=2
MAX_ACCOUNTS=5

# Random Star amount per account is drawn between MIN and MAX.
# Only accounts with balance >= MAX_STARS are eligible.
MIN_STARS=3
MAX_STARS=5

# Comma-separated list of allowed reactions
REACTIONS=❤️,👍,🔥,🎉
